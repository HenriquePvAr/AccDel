# Non-secret staging configuration. `npm run staging:up` copies this file to
# .env.staging when needed and writes generated secrets only under .pilot/.
APP_ENV=staging
NODE_ENV=production
POSTGRES_USER=cain
POSTGRES_DB=cain_pilot
STAGING_POSTGRES_PORT=55432
STAGING_API_PORT=3333
STAGING_ADMIN_PORT=4173
STAGING_WAITER_PORT=4174
API_PORT=3333
PUBLIC_WEB_URL=http://localhost:4173
PUBLIC_API_URL=http://localhost:3333
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174
JWT_ACCESS_EXPIRES_IN=8h
EXPECTED_MIGRATION_COUNT=23

# External providers stay fail-closed in the supervised pilot.
WHATSAPP_PROVIDER=disabled
AI_PROVIDER=disabled
MESSAGING_SANDBOX_MODE=true
MESSAGING_ALLOWED_RECIPIENTS=

# Server-side rollout boundaries. Printing is virtual/dry-run only.
FEATURE_WHATSAPP_ENABLED=false
FEATURE_AI_ATTENDANT_ENABLED=false
FEATURE_PRINTING_ENABLED=true
FEATURE_WAITER_PWA_ENABLED=true
FEATURE_PUBLIC_TRACKING_ENABLED=true
FEATURE_ORDER_NOTIFICATIONS_ENABLED=false
PUBLIC_TRACKING_TTL_MINUTES=1440

# Pilot seed guardrails. Credentials are generated outside this tracked file.
ALLOW_PILOT_SEED=true
PILOT_CREDENTIALS_OUTPUT=/pilot/seed-credentials.txt

# Print agent is connected only to FILE_OR_VIRTUAL printers.
CAIN_PRINT_AGENT_NAME=Cain Pilot Dry Run Agent
CAIN_PRINT_AGENT_VERSION=0.1.0-pilot
CAIN_PRINT_POLL_INTERVAL_MS=2000
CAIN_PRINT_HEARTBEAT_INTERVAL_MS=15000
CAIN_PRINT_MAX_CONCURRENT_JOBS=1
CAIN_PRINT_DRY_RUN=true
CAIN_PRINT_OUTPUT_DIR=/app/var/print-output
CAIN_PRINT_DATA_DIR=/app/var
CAIN_PRINT_LOG_LEVEL=info
