{
  "name": "@cain-delivery/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.build.tsbuildinfo',{force:true});\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "tsx --test src/config/environment.validation.test.ts src/modules/auth/authorization-hardening.test.ts src/modules/drivers/driver-tenant-isolation.test.ts src/modules/orders/order-state-machine.test.ts src/modules/orders/payment-state-machine.test.ts src/modules/orders/repeat-order-policy.test.ts src/modules/orders/repeat-order.service.test.ts src/modules/cash/cash-domain.test.ts src/modules/printing/print-agent-auth.test.ts src/modules/printing/printing-policy.test.ts src/modules/printing/printing-utils.test.ts src/modules/ai-attendant/webhook-security.service.test.ts src/modules/ai-attendant/webhook-receipt.service.test.ts src/modules/ai-attendant/cloud-ai-conversation.processor.test.ts src/modules/ai-attendant/tools/ai-tool.registry.test.ts src/modules/ai-attendant/providers/nvidia/nvidia-ai.gateway.test.ts src/modules/messaging/infrastructure/whatsapp-cloud/whatsapp-cloud.test.ts src/modules/messaging/application/messaging-reliability.test.ts src/modules/tracking/public-tracking.service.test.ts src/shared/store-context.test.ts src/shared/security/rate-limit.service.test.ts src/shared/security/idempotency.service.test.ts",
    "test:integration": "tsx --test src/security.integration.test.ts src/modules/cash/cash-register.integration.test.ts src/modules/messaging/messaging-hardening.integration.test.ts src/modules/printing/printing.integration.test.ts src/modules/waiter/waiter.integration.test.ts",
    "integrations:prevalidate": "tsx scripts/prevalidate-integrations.ts",
    "integrations:test:nvidia": "tsx scripts/test-nvidia-real.ts",
    "db:embedded": "tsx scripts/start-embedded-postgres.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "seed:pilot": "tsx prisma/seed-pilot.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
