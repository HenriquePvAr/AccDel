model AiAttendantSettings {
  id                           String          @id @default(uuid())
  storeId                      String          @unique @map("store_id")
  isEnabled                    Boolean         @default(false) @map("is_enabled")
  mode                         AiAttendantMode @default(off)
  assistantName                String          @default("Atendente Cain") @map("assistant_name")
  mainPrompt                   String          @default("Voce e um atendente virtual de delivery. Responda de forma educada, clara e humanizada. Use apenas informacoes oficiais da loja, cardapio e base de conhecimento. Se nao souber, chame um atendente humano.") @map("main_prompt")
  minDelaySeconds              Int             @default(8) @map("min_delay_seconds")
  maxDelaySeconds              Int             @default(25) @map("max_delay_seconds")
  messageGroupingSeconds       Int             @default(6) @map("message_grouping_seconds")
  answerOnlyDuringBusinessHours Boolean        @default(true) @map("answer_only_during_business_hours")
  transferOnLowConfidence       Boolean        @default(true) @map("transfer_on_low_confidence")
  transferOnComplaint           Boolean        @default(true) @map("transfer_on_complaint")
  transferOnCancellation        Boolean        @default(true) @map("transfer_on_cancellation")
  transferOnHumanRequest        Boolean        @default(true) @map("transfer_on_human_request")
  tone                         AiAttendantTone @default(friendly)
  useEmojis                    Boolean         @default(true) @map("use_emojis")
  callCustomerByName           Boolean         @default(true) @map("call_customer_by_name")
  responseLength               AiResponseLength @default(medium) @map("response_length")
  neverInventPrice             Boolean         @default(true) @map("never_invent_price")
  neverInventProduct           Boolean         @default(true) @map("never_invent_product")
  neverInventPromotion         Boolean         @default(true) @map("never_invent_promotion")
  neverPromiseDeliveryTime     Boolean         @default(true) @map("never_promise_delivery_time")
  allowTestWhatsappSend        Boolean         @default(false) @map("allow_test_whatsapp_send")
  defaultTestWhatsappNumber    String?         @map("default_test_whatsapp_number")
  upsellEnabled                Boolean         @default(true) @map("upsell_enabled")
  upsellMaxSuggestions         Int             @default(2) @map("upsell_max_suggestions")
  greetingMessage              String?         @map("greeting_message")
  outOfHoursMessage            String?         @map("out_of_hours_message")
  humanHandoffMessage          String?         @map("human_handoff_message")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("ai_attendant_settings")
}

model AiOrderDraft {
  id             String             @id @default(uuid())
  conversationId String             @map("conversation_id")
  customerId     String?            @map("customer_id")
  rawText        String             @map("raw_text")
  parsedItems    Json               @default("[]") @map("parsed_items")
  missingFields  Json               @default("[]") @map("missing_fields")
  metadata       Json?
  status         AiOrderDraftStatus @default(suggested)
  approvedAt     DateTime?          @map("approved_at")
  convertedOrderId String?          @map("converted_order_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("ai_order_drafts")
}
