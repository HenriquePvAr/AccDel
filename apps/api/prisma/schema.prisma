model DiningArea {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  color     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tables DiningTable[]

  @@index([storeId, sortOrder])
  @@map("dining_areas")
}

model DiningTable {
  id               String            @id @default(uuid())
  storeId          String            @map("store_id")
  areaId           String            @map("area_id")
  waiterId         String?           @map("waiter_id")
  code             String
  capacity         Int
  status           DiningTableStatus @default(free)
  guests           Int?              @map("guest_count")
  notes            String?
  currentSessionId String?           @unique @map("current_session_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  area           DiningArea    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  waiter         User?         @relation("TableWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  currentSession TableSession? @relation("CurrentTableSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  sessions       TableSession[] @relation("TableSessions")

  @@unique([storeId, code])
  @@index([storeId, areaId, status])
  @@index([waiterId, status])
  @@map("dining_tables")
}

model TableSession {
  id            String             @id @default(uuid())
  storeId       String             @map("store_id")
  tableId       String             @map("table_id")
  waiterId      String?            @map("waiter_id")
  closedById    String?            @map("closed_by_id")
  guestCount    Int                @default(1) @map("guest_count")
  subtotal      Decimal            @default(0) @db.Decimal(10, 2)
  discount      Decimal            @default(0) @db.Decimal(10, 2)
  serviceFee    Decimal            @default(0) @map("service_fee") @db.Decimal(10, 2)
  total         Decimal            @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod?     @map("payment_method")
  status        TableSessionStatus @default(open)
  notes         String?
  openedAt      DateTime           @default(now()) @map("opened_at")
  closedAt      DateTime?          @map("closed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table           DiningTable         @relation("TableSessions", fields: [tableId], references: [id], onDelete: Cascade)
  waiter          User?               @relation("SessionWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  closedBy        User?               @relation("SessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  currentForTable DiningTable?        @relation("CurrentTableSession")
  items           TableSessionItem[]
  events          TableSessionEvent[]

  @@index([storeId, status, openedAt])
  @@index([tableId, status])
  @@index([waiterId, openedAt])
  @@map("table_sessions")
}

model TableSessionItem {
  id         String   @id @default(uuid())
  sessionId   String   @map("session_id")
  productId   String?  @map("product_id")
  name        String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(10, 2)
  notes       String?
  options     Json     @default("[]")
  createdByName String? @map("created_by_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([productId])
  @@map("table_session_items")
}

model TableSessionEvent {
  id        String                @id @default(uuid())
  sessionId String                @map("session_id")
  type      TableSessionEventType
  label     String
  actor     String
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now()) @map("created_at")

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("table_session_events")
}

// ── AI Attendant models ─────────────────────────────────────────────

model WhatsappSession {
  id                   String                @id @default(uuid())
  storeId              String                @map("store_id")
  provider             String
  sessionName          String                @map("session_name")
  phoneNumber          String?               @map("phone_number")
  displayName          String?               @map("display_name")
  status               WhatsappSessionStatus @default(disconnected)
  qrCode               String?               @map("qr_code")
  qrCodeExpiresAt      DateTime?             @map("qr_code_expires_at")
  lastConnectedAt      DateTime?             @map("last_connected_at")
  lastDisconnectedAt   DateTime?             @map("last_disconnected_at")
  lastError            String?               @map("last_error")
  isEnabled            Boolean               @default(true) @map("is_enabled")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages      WhatsappMessage[]
  conversations AiConversation[]
  integrationLogs WhatsappIntegrationLog[]

  @@index([storeId, status])
  @@map("whatsapp_sessions")
}

model WhatsappMessage {
  id                String                    @id @default(uuid())
  storeId           String                    @map("store_id")
  sessionId         String                    @map("session_id")
  conversationId    String?                   @map("conversation_id")
  externalMessageId String?                   @map("external_message_id")
  fromNumber        String                    @map("from_number")
  toNumber          String                    @map("to_number")
  direction         WhatsappMessageDirection
  senderType        WhatsappMessageSenderType
  body              String
  rawPayload        Json?                     @map("raw_payload")
  status            WhatsappMessageStatus     @default(received)
  scheduledSendAt   DateTime?                 @map("scheduled_send_at")
  sentAt            DateTime?                 @map("sent_at")
  failedAt          DateTime?                 @map("failed_at")
  errorMessage      String?                   @map("error_message")
  metadata          Json?
  createdAt         DateTime                  @default(now()) @map("created_at")

  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session      WhatsappSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversation AiConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([sessionId, createdAt])
  @@index([conversationId, createdAt])
  @@index([fromNumber, createdAt])
  @@map("whatsapp_messages")
}

model AiConversation {
  id                 String               @id @default(uuid())
  storeId            String               @map("store_id")
  whatsappSessionId  String               @map("whatsapp_session_id")
  customerId         String?              @map("customer_id")
  whatsappNumber     String               @map("whatsapp_number")
  customerName       String?              @map("customer_name")
  type               AiConversationType   @default(real)
  status             AiConversationStatus @default(open)
  assignedUserId     String?              @map("assigned_user_id")
  assignedAt         DateTime?            @map("assigned_at")
  unreadCount        Int                  @default(0) @map("unread_count")
  isAiPaused         Boolean              @default(false) @map("is_ai_paused")
  lastStatus         String?              @map("last_status")
  lastError          String?              @map("last_error")
  lastMessageAt      DateTime?            @map("last_message_at")
  lastAiResponseAt   DateTime?            @map("last_ai_response_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  whatsappSession  WhatsappSession  @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages         AiMessage[]
  whatsappMessages WhatsappMessage[]
  orderDrafts      AiOrderDraft[]

  @@index([storeId, status, lastMessageAt])
  @@index([whatsappSessionId, whatsappNumber])
  @@index([customerId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String                    @id @default(uuid())
  conversationId String                    @map("conversation_id")
  direction      WhatsappMessageDirection
  senderType     WhatsappMessageSenderType
  body           String
  rawPayload     Json?                     @map("raw_payload")
  status         WhatsappMessageStatus     @default(received)
  scheduledSendAt DateTime?                @map("scheduled_send_at")
  sentAt         DateTime?                 @map("sent_at")
  failedAt       DateTime?                 @map("failed_at")
  errorMessage   String?                   @map("error_message")
  metadata       Json?
  createdAt      DateTime                  @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model WhatsappIntegrationLog {
  id        String                       @id @default(uuid())
  storeId   String                       @map("store_id")
  sessionId String?                      @map("session_id")
  type      WhatsappIntegrationLogType
  status    IntegrationLogStatus         @default(info)
  message   String
  metadata  Json?
  createdAt DateTime                     @default(now()) @map("created_at")

  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session WhatsappSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, status])
  @@map("whatsapp_integration_logs")
}

model AiKnowledgeEntry {
