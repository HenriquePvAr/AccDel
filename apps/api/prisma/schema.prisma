  fromLongitude   Decimal? @map("from_longitude") @db.Decimal(10, 7)
  toLatitude      Decimal? @map("to_latitude") @db.Decimal(10, 7)
  toLongitude     Decimal? @map("to_longitude") @db.Decimal(10, 7)
  routeGeometry   Json?    @map("route_geometry")
