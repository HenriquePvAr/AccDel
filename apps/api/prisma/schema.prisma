generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  in_analysis
  in_preparation
  ready
  out_for_delivery
  completed
  cancelled
}

enum OrderChannel {
  delivery
  dine_in
  counter
  pickup
  digital_menu
  whatsapp
}

enum PaymentMethod {
  pix
  credit_card
  debit_card
  cash
  meal_voucher
  payment_link
}

enum PaymentProvider {
  manual
  pix
  picpay
}

enum PaymentStatus {
  paid
  pending
  refunded
}

enum PriorityLevel {
  normal
  priority
  vip
}

enum ProductChannel {
  dine_in
  delivery
  digital_menu
  counter
}

enum PromotionDiscountType {
  percent
  fixed
  combo
}

enum CouponDiscountType {
  percent
  fixed
}

enum CommercialStatus {
  active
  inactive
  scheduled
  expired
}

enum CashRegisterStatus {
  open
  closing
  closed
}

enum CashMovementType {
  sale
  withdrawal
  supply
  adjustment
  refund
}

enum AdminRole {
  owner
  manager
  attendant
  cashier
  kitchen
  waiter
  driver
  supervisor
}

enum UserStatus {
  active
  inactive
}

enum DriverAvailabilityStatus {
  available
  delivering
  paused
}

enum WaiterOperationalStatus {
  available
  serving
  paused
}

enum DiningTableStatus {
  free
  occupied
  reserved
  closing
  closed
}

enum TableSessionStatus {
  open
  awaiting_close
  closed
}

enum TableSessionEventType {
  opened
  item_added
  waiter_assigned
  awaiting_close
  reopened
  closed
  transferred
  split
  updated
}

enum DriverLocationSource {
  gps
  app
  admin
  simulator
  fallback
}

enum DeliveryAssignmentStatus {
  active
  completed
  cancelled
}

// ── AI Attendant enums ──────────────────────────────────────────────

enum WhatsappSessionStatus {
  disconnected
  waiting_qr
  connecting
  connected
  expired
  error
}

enum WhatsappMessageDirection {
  inbound
  outbound
}

enum WhatsappMessageSenderType {
  customer
  ai
  human
  system
}

enum WhatsappMessageStatus {
  received
  queued
  sent
  failed
}

enum AiConversationStatus {
  open
  waiting_ai
  waiting_human
  human_assigned
  closed
}

enum AiConversationType {
  real
  test
}

enum WhatsappIntegrationLogType {
  provider_status
  session_started
  session_disconnected
  session_restarted
  qr_requested
  webhook_received
  message_received
  message_sent
  message_failed
  ai_reply_generated
  ai_reply_failed
  delay_scheduled
  delay_cancelled
  human_assigned
  human_released
  conversation_closed
  test_chat
  test_whatsapp_sent
}

enum IntegrationLogStatus {
  info
  success
  warning
  error
}

enum AiAttendantMode {
  off
  suggestion
  automatic
  hybrid
}

enum AiAttendantTone {
  professional
  friendly
  casual
  premium
}

enum AiResponseLength {
  short
  medium
  detailed
}

enum AiKnowledgeEntryType {
  store_info
  faq
  policy
  delivery_area
  payment
  promotions
  cancellation
  custom
}

enum AiOrderDraftStatus {
  suggested
  approved
  converted
  discarded
}

model Store {
  id                String   @id @default(uuid())
  name              String
  tradeName         String   @map("trade_name")
  timezone          String   @default("America/Manaus")
  city              String
  state             String
  brandAccent       String   @map("brand_accent")
  logoUrl           String?  @map("logo_url")
  phone             String?
  publicWhatsapp    String?  @map("public_whatsapp")
  addressLine       String?  @map("address_line")
  neighborhood      String?
  businessHours     String?  @map("business_hours")
  businessDays      String[] @default(["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]) @map("business_days")
  greetingMessage   String?  @map("greeting_message")
  outOfHoursMessage String?  @map("out_of_hours_message")
  cancellationPolicy String? @map("cancellation_policy")
  generalNotes      String?  @map("general_notes")
  latitude          Decimal  @default(-3.1019000) @db.Decimal(10, 7)
  longitude         Decimal  @default(-60.0217000) @db.Decimal(10, 7)
  defaultDeliveryFee Decimal @default(0) @map("default_delivery_fee") @db.Decimal(10, 2)
  minimumOrderAmount Decimal @default(0) @map("minimum_order_amount") @db.Decimal(10, 2)
  deliveryEnabled   Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled     Boolean  @default(true) @map("pickup_enabled")
  counterEnabled    Boolean  @default(true) @map("counter_enabled")
  dineInEnabled     Boolean  @default(true) @map("dine_in_enabled")
  digitalMenuEnabled Boolean @default(true) @map("digital_menu_enabled")
  whatsappAiEnabled Boolean  @default(true) @map("whatsapp_ai_enabled")
  autoAcceptEnabled Boolean  @default(false) @map("auto_accept_enabled")
  estimatedPrepTimeMinutes     Int @default(30) @map("estimated_prep_time_minutes")
  estimatedDeliveryTimeMinutes Int @default(90) @map("estimated_delivery_time_minutes")
  estimatedDineInTimeMinutes   Int @default(50) @map("estimated_dine_in_time_minutes")
  estimatedCounterTimeMinutes  Int @default(25) @map("estimated_counter_time_minutes")
  estimatedPickupTimeMinutes   Int @default(30) @map("estimated_pickup_time_minutes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customers     Customer[]
  categories    Category[]
  products      Product[]
  orders        Order[]
  cashRegisters CashRegister[]
  users         StoreUser[]
  diningAreas   DiningArea[]
  diningTables  DiningTable[]
  tableSessions TableSession[]
  driverLocations DriverLocation[]
  deliveryAssignments DeliveryAssignment[]
  etaSnapshots EtaSnapshot[]
  optionGroups ProductOptionGroup[]
  promotions    Promotion[]
  coupons       Coupon[]
  paymentMethodConfigs PaymentMethodConfig[]
  deliveryZones DeliveryZone[]
  whatsappSessions     WhatsappSession[]
  whatsappMessages     WhatsappMessage[]
  whatsappIntegrationLogs WhatsappIntegrationLog[]
  aiConversations      AiConversation[]
  aiKnowledgeEntries   AiKnowledgeEntry[]
  aiProviderConfigs    AiProviderConfig[]
  aiAttendantSettings  AiAttendantSettings[]

  @@map("stores")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  stores       StoreUser[]
  driverOrders Order[]    @relation("DriverOrders")
  driverLocations DriverLocation[] @relation("DriverLocations")
  deliveryAssignments DeliveryAssignment[] @relation("DriverAssignments")
  etaSnapshots EtaSnapshot[] @relation("DriverEtaSnapshots")
  assignedTables      DiningTable[]  @relation("TableWaiter")
  waiterSessions      TableSession[] @relation("SessionWaiter")
  closedTableSessions TableSession[] @relation("SessionCloser")

  @@index([status, createdAt])
  @@map("users")
}

model StoreUser {
  id        String    @id @default(uuid())
  storeId   String    @map("store_id")
  userId    String    @map("user_id")
  role      AdminRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile?
  waiterProfile WaiterProfile?
  deliveryAssignments DeliveryAssignment[] @relation("AssignmentStoreUser")

  @@unique([storeId, userId])
  @@index([storeId, role, active])
  @@index([userId, active])
  @@map("store_users")
}

model DriverProfile {
  id             String                   @id @default(uuid())
  storeUserId    String                   @unique @map("store_user_id")
  vehicle        String
  active         Boolean                  @default(true)
  availability   DriverAvailabilityStatus @default(available)
  lastActivityAt DateTime?                @map("last_activity_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  storeUser StoreUser @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  locations DriverLocation[]

  @@index([active, availability])
  @@map("driver_profiles")
}

model WaiterProfile {
  id             String                  @id @default(uuid())
  storeUserId    String                  @unique @map("store_user_id")
  active         Boolean                 @default(true)
  status         WaiterOperationalStatus @default(available)
  totalOrders    Int                     @default(0) @map("total_orders")
  totalSales     Decimal                 @default(0) @map("total_sales") @db.Decimal(10, 2)
  tablesServed   Int                     @default(0) @map("tables_served")
  cancellations  Int                     @default(0)
  lastActivityAt DateTime?               @map("last_activity_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  storeUser StoreUser            @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  history   WaiterHistoryEntry[]

  @@index([active, status])
  @@map("waiter_profiles")
}

model WaiterHistoryEntry {
  id              String    @id @default(uuid())
  waiterProfileId String    @map("waiter_profile_id")
  label           String
  value           Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now()) @map("created_at")

  waiterProfile WaiterProfile @relation(fields: [waiterProfileId], references: [id], onDelete: Cascade)

  @@index([waiterProfileId, createdAt])
  @@map("waiter_history_entries")
}

model Customer {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  phone     String
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses       CustomerAddress[]
  orders          Order[]
  aiConversations AiConversation[]

  @@index([storeId, phone])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  label      String
  street     String
  number     String
  district   String
  complement String?
  city       String
  state      String
  reference  String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model Category {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  description String
  active      Boolean  @default(true)
  icon        String?
  color       String?
  visibleOnPos         Boolean @default(true) @map("visible_on_pos")
  visibleOnDigitalMenu Boolean @default(true) @map("visible_on_digital_menu")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]
  optionGroupLinks ProductOptionGroupCategoryLink[]

  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  categoryId         String   @map("category_id")
  name               String
  description        String
  price              Decimal  @db.Decimal(10, 2)
  image              String
  featured           Boolean  @default(false)
  active             Boolean  @default(true)
  preparationStation String   @map("preparation_station")
  tags               String[] @default([])
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  store        Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availability ProductChannelAvailability[]
  optionGroups ProductOptionGroupLink[]
  orderItems   OrderItem[]
  tableSessionItems TableSessionItem[]

  @@index([storeId, active])
  @@index([categoryId])
  @@map("products")
}

model ProductChannelAvailability {
  id            String         @id @default(uuid())
  productId     String         @map("product_id")
  channel       ProductChannel
  available     Boolean        @default(true)
  visible       Boolean        @default(true)
  soldOut       Boolean        @default(false) @map("sold_out")
  priceOverride Decimal?       @map("price_override") @db.Decimal(10, 2)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([channel, available, visible])
  @@map("product_channels")
}

model ProductOptionGroup {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options      ProductOption[]
  productLinks ProductOptionGroupLink[]
  categoryLinks ProductOptionGroupCategoryLink[]

  @@unique([storeId, name])
  @@index([storeId, sortOrder])
  @@map("product_option_groups")
}

model ProductOption {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  name        String
  description String?
  image       String?
  priceDelta  Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  active      Boolean  @default(true)
  available   Boolean  @default(true)
  soldOut     Boolean  @default(false) @map("sold_out")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@index([groupId, sortOrder])
  @@map("product_options")
}

model ProductOptionGroupLink {
  productId     String  @map("product_id")
  groupId       String  @map("group_id")
  required      Boolean @default(false)
  minSelections Int     @default(0) @map("min_selections")
  maxSelections Int     @default(1) @map("max_selections")
  sortOrder     Int     @default(0) @map("sort_order")
  description   String?
  autoApplied   Boolean @default(false) @map("auto_applied")

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
  @@map("product_option_group_links")
}

model ProductOptionGroupCategoryLink {
  categoryId    String  @map("category_id")
  groupId       String  @map("group_id")
  required      Boolean @default(false)
  minSelections Int     @default(0) @map("min_selections")
  maxSelections Int     @default(1) @map("max_selections")
  sortOrder     Int     @default(0) @map("sort_order")
  description   String?
  autoApply     Boolean @default(true) @map("auto_apply")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group    ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([categoryId, groupId])
  @@index([groupId])
  @@map("product_option_group_category_links")
}

model Promotion {
  id            String                @id @default(uuid())
  storeId       String                @map("store_id")
  name          String
  description   String?
  type          PromotionDiscountType
  discountValue Decimal?              @map("discount_value") @db.Decimal(10, 2)
  status        CommercialStatus      @default(inactive)
  startsAt      DateTime?             @map("starts_at")
  endsAt        DateTime?             @map("ends_at")
  channels      ProductChannel[]      @default([])
  productIds    String[]              @default([]) @map("product_ids")
  categoryIds   String[]              @default([]) @map("category_ids")
  rules          Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("promotions")
}

model Coupon {
  id             String             @id @default(uuid())
  storeId        String             @map("store_id")
  code           String
  description    String?
  type           CouponDiscountType
  value          Decimal            @db.Decimal(10, 2)
  minOrderAmount Decimal            @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxUses        Int?               @map("max_uses")
  uses           Int                @default(0)
  status         CommercialStatus   @default(inactive)
  validFrom      DateTime?          @map("valid_from")
  validUntil     DateTime?          @map("valid_until")
  channels       ProductChannel[]   @default([])
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, status])
  @@map("coupons")
}

model PaymentMethodConfig {
  id               String          @id @default(uuid())
  storeId          String          @map("store_id")
  name             String
  method           PaymentMethod?  @map("method")
  provider         PaymentProvider @default(manual)
  active           Boolean         @default(true)
  fixed            Boolean         @default(false)
  requiresReceipt  Boolean         @default(false) @map("requires_receipt")
  autoCashEntry    Boolean         @default(true) @map("auto_cash_entry")
  channels         ProductChannel[] @default([])
  sortOrder        Int             @default(0) @map("sort_order")
  externalEnabled  Boolean         @default(false) @map("external_enabled")
  externalPaymentId String?        @map("external_payment_id")
  qrCodePayload    String?         @map("qr_code_payload")
  qrCodeUrl        String?         @map("qr_code_url")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([storeId, active, sortOrder])
  @@map("payment_method_configs")
}

model DeliveryZone {
  id                           String   @id @default(uuid())
  storeId                      String   @map("store_id")
  neighborhood                 String
  fee                          Decimal  @default(0) @db.Decimal(10, 2)
  active                       Boolean  @default(true)
  sortOrder                    Int      @default(0) @map("sort_order")
  estimatedDeliveryTimeMinutes Int?     @map("estimated_delivery_time_minutes")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, neighborhood])
  @@index([storeId, active, sortOrder])
  @@map("delivery_zones")
}

model Order {
  id            String        @id @default(uuid())
  storeId       String        @map("store_id")
  number        String
  customerId    String?       @map("customer_id")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  source        OrderChannel
  serviceType   OrderChannel  @map("service_type")
  status        OrderStatus
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @map("payment_status")
  total         Decimal       @db.Decimal(10, 2)
  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  couponCode    String?       @map("coupon_code")
  promotionName String?       @map("promotion_name")
  discountBreakdown Json?     @map("discount_breakdown")
  dueAt         DateTime      @map("due_at")
  estimatedPrepTimeMinutes     Int? @map("estimated_prep_time_minutes")
  estimatedDeliveryTimeMinutes Int? @map("estimated_delivery_time_minutes")
  estimatedTotalTimeMinutes    Int? @map("estimated_total_time_minutes")
  priority      PriorityLevel @default(normal)
  delayed       Boolean       @default(false)
  tags          String[]      @default([])
  addressLabel  String?       @map("address_label")
  addressText   String?       @map("address_text")
  deliveryLatitude  Decimal?  @map("delivery_latitude") @db.Decimal(10, 7)
  deliveryLongitude Decimal?  @map("delivery_longitude") @db.Decimal(10, 7)
  tableCode     String?       @map("table_code")
  notes         String?
  driverId      String?       @map("driver_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  driver   User?                @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  history  OrderStatusHistory[]
  deliveryAssignments DeliveryAssignment[]
  etaSnapshots EtaSnapshot[]
  driverLocations DriverLocation[]

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([customerId])
  @@index([paymentMethod])
  @@index([driverId, status])
  @@map("orders")
}

model DriverLocation {
  id              String               @id @default(uuid())
  storeId         String               @map("store_id")
  driverId        String               @map("driver_id")
  driverProfileId String               @map("driver_profile_id")
  orderId         String?              @map("order_id")
  assignmentId    String?              @map("assignment_id")
  latitude        Decimal              @db.Decimal(10, 7)
  longitude       Decimal              @db.Decimal(10, 7)
  speedKmh        Decimal?             @map("speed_kmh") @db.Decimal(6, 2)
  heading         Decimal?             @db.Decimal(6, 2)
  accuracyMeters  Decimal?             @map("accuracy_meters") @db.Decimal(8, 2)
  source          DriverLocationSource @default(gps)
  capturedAt      DateTime             @map("captured_at")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  driver        User          @relation("DriverLocations", fields: [driverId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignment    DeliveryAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([storeId, isActive, capturedAt])
  @@index([driverId, isActive, capturedAt])
  @@index([driverProfileId, capturedAt])
  @@index([orderId, capturedAt])
  @@index([assignmentId, capturedAt])
  @@map("driver_locations")
}

model DeliveryAssignment {
  id              String                   @id @default(uuid())
  storeId         String                   @map("store_id")
  orderId         String                   @map("order_id")
  driverId        String                   @map("driver_id")
  storeUserId     String                   @map("store_user_id")
  plannedSequence Int                      @default(1) @map("planned_sequence")
  finalSequence   Int                      @default(1) @map("final_sequence")
  actualSequence  Int?                     @map("actual_sequence")
  status          DeliveryAssignmentStatus @default(active)
  assignedAt      DateTime                 @default(now()) @map("assigned_at")
  completedAt     DateTime?                @map("completed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver    User      @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Cascade)
  storeUser StoreUser @relation("AssignmentStoreUser", fields: [storeUserId], references: [id], onDelete: Cascade)
  driverLocations DriverLocation[]

  @@unique([orderId, status])
  @@index([storeId, driverId, status, finalSequence])
  @@index([driverId, status, assignedAt])
  @@map("delivery_assignments")
}

