DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cain_delivery_admin?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cain_delivery_admin?schema=public"
API_PORT=3333
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=8h

# NVIDIA NIM / API Catalog. Select nvidia only after filling every required value.
AI_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_TIMEOUT_MS=20000
NVIDIA_MAX_REQUESTS_PER_MINUTE=30
NVIDIA_MAX_CONCURRENT_REQUESTS=2
NVIDIA_MAX_OUTPUT_TOKENS=600

# Meta WhatsApp Cloud API (primary integration). Set WHATSAPP_PROVIDER=cloud after configuration.
WHATSAPP_PROVIDER=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_STORE_ID=
WHATSAPP_WEBHOOK_PUBLIC_URL=https://api.example.invalid/webhooks/whatsapp
WHATSAPP_HTTP_TIMEOUT_MS=10000
WHATSAPP_OUTBOX_MAX_ATTEMPTS=5
WHATSAPP_OUTBOX_POLL_INTERVAL_MS=1000

# Safe rollout boundary. Production requires an explicit true/false value.
# When true, an empty allowlist blocks every outbound message.
MESSAGING_SANDBOX_MODE=true
MESSAGING_ALLOWED_RECIPIENTS=

# Approved utility templates used outside the rolling 24-hour customer service window.
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PREPARING=
WHATSAPP_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=

# Public tracking tokens are random, stored only as SHA-256 and expire automatically.
PUBLIC_TRACKING_TTL_MINUTES=1440

# Explicit legacy mode only. There is no automatic fallback from Cloud API.
# WHATSAPP_PROVIDER=evolution_api
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_WEBHOOK_URL=
WHATSAPP_PROVIDER_INTEGRATION=WHATSAPP-BAILEYS
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_MAX_AGE_SECONDS=300
WHATSAPP_WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Optional diagnostics/integrations; not used as Cain database or primary AI provider.
LOVABLE_SUPABASE_URL=
LOVABLE_SUPABASE_PUBLISHABLE_KEY=
LOVABLE_SUPABASE_PROJECT_ID=
LOVABLE_BOT_REPLY_URL=
LOVABLE_BOT_REPLY_SECRET=
LOVABLE_BOT_REPLY_TIMEOUT_MS=20000
