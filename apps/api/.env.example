DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cain_delivery_admin?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cain_delivery_admin?schema=public"
API_PORT=3333
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JWT_ACCESS_SECRET=cain-admin-local-secret
JWT_ACCESS_EXPIRES_IN=8h

# Optional Lovable/Supabase diagnostics only. Not used as Cain database or AI provider.
LOVABLE_SUPABASE_URL=
LOVABLE_SUPABASE_PUBLISHABLE_KEY=
LOVABLE_SUPABASE_PROJECT_ID=

# Real AI provider configuration. Required before the attendant can generate AI replies.
AI_PROVIDER=groq
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=llama-3.3-70b-versatile

# Optional Lovable backend provider. Secret must match CAIN_WEBHOOK_SECRET in Lovable.
LOVABLE_BOT_REPLY_URL=
LOVABLE_BOT_REPLY_SECRET=
LOVABLE_BOT_REPLY_TIMEOUT_MS=20000

# Optional WhatsApp provider. Values stay in the API environment only.
WHATSAPP_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
WHATSAPP_WEBHOOK_MAX_AGE_SECONDS=300
WHATSAPP_WEBHOOK_MAX_PAYLOAD_BYTES=262144
WHATSAPP_PROVIDER=evolution_api
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_WEBHOOK_URL=
WHATSAPP_PROVIDER_INTEGRATION=WHATSAPP-BAILEYS
