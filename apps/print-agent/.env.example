CAIN_API_BASE_URL=http://127.0.0.1:3333
CAIN_PRINT_AGENT_TOKEN=
CAIN_PRINT_AGENT_NAME=Cain Print Agent
CAIN_PRINT_AGENT_VERSION=0.1.0
CAIN_PRINT_POLL_INTERVAL_MS=2000
CAIN_PRINT_HEARTBEAT_INTERVAL_MS=30000
CAIN_PRINT_MAX_CONCURRENT_JOBS=1
CAIN_PRINT_DRY_RUN=true
CAIN_PRINT_OUTPUT_DIR=./var/print-output
CAIN_PRINT_DATA_DIR=./var
CAIN_PRINT_LOG_LEVEL=info
CAIN_PRINT_HTTP_TIMEOUT_MS=10000
CAIN_PRINT_TCP_TIMEOUT_MS=5000
CAIN_PRINT_DRY_RUN_RETENTION_HOURS=24
