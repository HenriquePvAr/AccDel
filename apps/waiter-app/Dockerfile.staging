FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY apps/waiter-app/package.json apps/waiter-app/package-lock.json ./
RUN npm ci
COPY apps/waiter-app/index.html apps/waiter-app/tsconfig*.json apps/waiter-app/vite.config.ts apps/waiter-app/postcss.config.js apps/waiter-app/eslint.config.js ./
COPY apps/waiter-app/public ./public
COPY apps/waiter-app/src ./src
ARG VITE_API_BASE_URL=http://localhost:3333
ARG VITE_STORE_ID=store_main
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_STORE_ID=$VITE_STORE_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/spa.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
