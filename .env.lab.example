# Cain Delivery controlled laboratory profile.
# Copy to .env.lab only when instructed. Real runtime secrets are generated
# under the ignored .pilot/lab directory and must never be copied here.
LAB_RUNTIME_MARKER=CAIN_LAB_RUNTIME_V1
LAB_BIND_ADDRESS=127.0.0.1
LAB_PUBLIC_HOST=127.0.0.1
LAB_API_PORT=3333
LAB_ADMIN_PORT=4173
LAB_WAITER_PORT=4174
LAB_POSTGRES_PORT=55439
LAB_POSTGRES_DATABASE=cain_lab_pilot
LAB_POSTGRES_USER=cain_lab

APP_ENV=staging
WHATSAPP_PROVIDER=disabled
AI_PROVIDER=disabled
MESSAGING_SANDBOX_MODE=true
MESSAGING_ALLOWED_RECIPIENTS=
FEATURE_WHATSAPP_ENABLED=false
FEATURE_AI_ATTENDANT_ENABLED=false
FEATURE_PRINTING_ENABLED=true
FEATURE_WAITER_PWA_ENABLED=true
FEATURE_PUBLIC_TRACKING_ENABLED=true
FEATURE_ORDER_NOTIFICATIONS_ENABLED=false

# External routing is forced to an unavailable loopback endpoint so the API
# uses its deterministic fallback without internet traffic.
OSRM_BASE_URL=http://127.0.0.1:9

# Secrets are generated at runtime. These labels are documentation only.
LAB_POSTGRES_PASSWORD=GENERATED_UNDER_IGNORED_PILOT_DIRECTORY
LAB_JWT_ACCESS_SECRET=GENERATED_UNDER_IGNORED_PILOT_DIRECTORY
LAB_PILOT_USER_PASSWORD=GENERATED_UNDER_IGNORED_PILOT_DIRECTORY
LAB_PRINT_AGENT_TOKEN=GENERATED_UNDER_IGNORED_PILOT_DIRECTORY
